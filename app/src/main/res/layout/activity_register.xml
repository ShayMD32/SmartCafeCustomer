<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Brand identity -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="SMART CAFÉ"
            android:textColor="#A57550"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Join the café."
            android:textColor="#35241C"
            android:textSize="32sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Create your account and start discovering your favourites."
            android:textColor="#75665E"
            android:textSize="15sp"/>

        <!-- Registration form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_menu_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FULL NAME"
                android:textColor="#35241C"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/editTextFullName"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#A57550"
                android:hint="Enter your full name"
                android:inputType="textPersonName"
                android:autofillHints="name"
                android:singleLine="true"
                android:textColor="#35241C"
                android:textColorHint="#94867D"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="EMAIL ADDRESS"
                android:textColor="#35241C"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/editTextRegisterEmail"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#A57550"
                android:hint="you@example.com"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                android:singleLine="true"
                android:textColor="#35241C"
                android:textColorHint="#94867D"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="PASSWORD"
                android:textColor="#35241C"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/editTextRegisterPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#A57550"
                android:hint="Create a password"
                android:inputType="textPassword"
                android:autofillHints="newPassword"
                android:singleLine="true"
                android:textColor="#35241C"
                android:textColorHint="#94867D"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Use at least 8 characters."
                android:textColor="#75665E"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="CONFIRM PASSWORD"
                android:textColor="#35241C"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/editTextConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#A57550"
                android:hint="Re-enter your password"
                android:inputType="textPassword"
                android:autofillHints="newPassword"
                android:singleLine="true"
                android:textColor="#35241C"
                android:textColorHint="#94867D"/>

            <Button
                android:id="@+id/buttonCreateAccount"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="#35241C"
                android:text="Create Account"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Return to login -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="Already have an account?"
            android:textColor="#75665E"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/buttonBackToLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#E9DED3"
            android:text="Back to Sign In"
            android:textAllCaps="false"
            android:textColor="#35241C"
            android:textSize="15sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="GOOD COFFEE. GOOD MOMENTS."
            android:textColor="#A57550"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"/>

    </LinearLayout>
</ScrollView>
