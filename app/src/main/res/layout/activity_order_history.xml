<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5F0"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Branding and screen heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="SMART CAFÉ"
        android:textColor="#A57550"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Your orders"
        android:textColor="#35241C"
        android:textSize="30sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Every favourite, all in one place."
        android:textColor="#75665E"
        android:textSize="15sp"/>

    <!-- Loading, empty and error messages -->
    <TextView
        android:id="@+id/textOrderStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:text="Loading your orders..."
        android:textColor="#75665E"
        android:textSize="14sp"
        android:accessibilityLiveRegion="polite"/>

    <!-- Order cards populated by OrderHistoryActivity -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/ordersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="12dp"/>
    </ScrollView>

    <!-- Navigation -->
    <Button
        android:id="@+id/buttonBackToMenu"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#35241C"
        android:text="Explore Menu"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"/>

    <Button
        android:id="@+id/buttonBackToDashboard"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#E9DED3"
        android:text="Back to Home"
        android:textAllCaps="false"
        android:textColor="#35241C"
        android:textSize="15sp"/>

</LinearLayout>
